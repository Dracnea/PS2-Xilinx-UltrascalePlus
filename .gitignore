# Vivado / LiteX build output
build/
*.jou
*.log
.Xil/
__pycache__/
*.pyc

# Build output is not tracked -- except the images promoted into bitstreams/,
# which are kept so a card can be brought up without a Vivado seat.
*.bit
!bitstreams/*.bit
*.mcs
*.ltx
csr.csv
!bitstreams/*.csr.csv
analyzer.csv
build_id.v
build_id.vh

venv/

# simulation and fit scratch
sim/work/
sim/work_dbg/
sim/ee/work/
fit/ee/*.rpt
# Vivado batch-mode droppings: fmax.tcl and fmax_pblock.tcl are run from the
# repo root, and Vivado writes these into the working directory.
clockInfo.txt
cong/
iter_*_CongestedCLBsAndNets.txt
.Xil/
*.jou
vivado*.log
sim/*.out
sim/*.hex
fit/*.out

# BIOS and disc images are the operator's own dumps and never belong here.
# This repository is public: a game image committed here would be redistributing
# someone else's copyrighted work, and git history cannot be quietly corrected
# afterwards. Keep this list ahead of the files, not behind them.
*.bin
!bitstreams/*.bin
*.iso
*.ISO
*.img
*.cue
*.bin.*
*.mdf
*.mds
*.nrg
*.chd
discs/
bios/

# LiteScope writes its config next to wherever the build was started
/zanalyzer_*.csv

# Vivado-generated HBM IP (18 MB); regenerate with ip/hbm/gen_hbm.tcl
/ip/hbm/hbm_0/
